# Environment khusus PHPUnit / feature test.
# Copy ke .env.testing untuk memastikan command `php artisan ... --env=testing`
# tidak pernah fallback ke database development.

APP_NAME="Agenda Kelas Digital (Testing)"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agenda_kelas_test
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array
