# .env.e2e.example
# Environment khusus E2E testing (Playwright).
#
# Cara pakai:
#   1. Copy file ini ke .env.e2e  (atau jalankan `npm run test:e2e:setup`)
#   2. Jalankan `npm run test:e2e`  — server test (port 8010) otomatis
#      migrate:fresh + seed (E2eDatabaseSeeder) setiap kali dinyalakan.
#
# IMPORTANT: file ini menunjuk ke DATABASE TEST TERPISAH (database/e2e.sqlite),
# BUKAN database development kamu. Data development kamu AMAN.
APP_NAME="Agenda Kelas Digital (E2E)"
APP_ENV=e2e
# Key lokal untuk keperluan test saja (bukan rahasia produksi).
APP_KEY=base64:cswY4jHm6ZONlX6uvnezWU1PoXKkDZqk9Ha5o2U3sTc=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# Path relatif ke root project. DB test terpisah dari database dev kamu.
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# PHP built-in server: proses worker paralel supaya test tidak antri.

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@e2e.test"
MAIL_FROM_NAME="${APP_NAME}"
